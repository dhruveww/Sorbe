###############################################################################
# SORBE — environment template
#
# Copy to:  apps/medusa/.env  and  apps/storefront/.env.local
#   cp .env.example apps/medusa/.env
#   cp .env.example apps/storefront/.env.local
#
# HOW TO READ THIS FILE
#   [NOW-FREE]  Fill this to build locally. Costs nothing.
#   [NOW-AUTO]  Already filled below. Don't change unless you know why.
#   [LAUNCH]    Only needed when you go live and take real money.
#   [OPTIONAL]  Only when you choose to enable that feature.
#
# GOLDEN RULE: only NEXT_PUBLIC_* vars reach the browser. Everything else is
# server-only. Never add NEXT_PUBLIC_ to a secret.
#
# Full procurement guide (where to click in each dashboard): docs/PLAN.md §17
###############################################################################


# =============================================================================
# 1. BRAND  [NOW-FREE — fill in your real details]
# =============================================================================
# The ONLY place the brand name lives. Changing it here rebrands the whole site.
NEXT_PUBLIC_BRAND_NAME=SORBE

# Legal details — appear in the footer, on invoices, and on legal pages.
# Placeholders are fine while building; real values required before launch.
BRAND_LEGAL_NAME=SORBE
BRAND_SUPPORT_EMAIL=hello@example.com
BRAND_SUPPORT_PHONE=+919999999999
BRAND_REGISTERED_ADDRESS=To be filled
BRAND_GSTIN=
# DPDP Act requires a named grievance officer on the privacy page.
BRAND_GRIEVANCE_OFFICER_NAME=To be filled
BRAND_GRIEVANCE_OFFICER_EMAIL=hello@example.com


# =============================================================================
# 2. DATABASE  [NOW-AUTO for local Docker | LAUNCH: swap to Supabase]
# =============================================================================
# Local Docker (free, no signup). Works as-is after `pnpm db:up`.
DATABASE_URL=postgres://sorbe:sorbe@localhost:5432/sorbe
DATABASE_URL_DIRECT=postgres://sorbe:sorbe@localhost:5432/sorbe

# --- At launch, replace the two above with Supabase --------------------------
# Supabase Dashboard -> Settings -> Database -> Connection string
#   DATABASE_URL         = "Connection pooling" (port 6543) + ?pgbouncer=true
#   DATABASE_URL_DIRECT  = "Direct connection"  (port 5432) — migrations ONLY
# Using the direct URL for the running app WILL exhaust connections. Don't.
#
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_URL_DIRECT=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase project API — needed for Auth (OTP) and Storage (product images).
# Dashboard -> Settings -> API.  Create the project in region: South Asia (Mumbai).
# !! Region CANNOT be changed later — pick Mumbai at creation time. !!
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# 3. REDIS  [NOW-AUTO for local Docker | LAUNCH: swap to Upstash]
# =============================================================================
# Sessions, OTP metadata, rate limits, pincode-quote cache, checkout lock.
REDIS_URL=redis://localhost:6379

# At launch: upstash.com -> your database -> "REST API" (free tier is fine).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# =============================================================================
# 4. MEDUSA  [NOW-FREE — generate the secrets yourself]
# =============================================================================
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Generate each with:  openssl rand -base64 32
JWT_SECRET=change-me-openssl-rand-base64-32
COOKIE_SECRET=change-me-openssl-rand-base64-32
# Shared only between the Next server and Medusa. Never sent to the browser.
MEDUSA_INTERNAL_AUTH_SECRET=change-me-openssl-rand-base64-32

# Created after Medusa first boots (see apps/medusa/README.md).
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_ADMIN_API_TOKEN=


# =============================================================================
# 5. AUTH / OTP  [NOW-FREE: leave as 'mock']
# =============================================================================
# mock  -> no network call, code is always OTP_MOCK_STATIC_CODE. Dev only.
# email -> Supabase Auth + Resend. Free. No DLT needed.
# whatsapp -> once WhatsApp is live. Moves login back to the phone number.
# sms   -> requires India DLT registration (~Rs 5,000). Deliberately unused.
OTP_CHANNEL=mock
OTP_MOCK_STATIC_CODE=000000

# For OTP_CHANNEL=email — resend.com, free tier: 3,000/month, 100/day.
RESEND_API_KEY=
OTP_FROM_EMAIL=login@example.com


# =============================================================================
# 6. PAYMENTS — Razorpay  [LAUNCH: leave mocked until you have KYC]
# =============================================================================
# true  -> "Simulate success / failure" buttons. No Razorpay account needed.
# false -> real Razorpay. Requires all three keys below.
# If RAZORPAY_KEY_ID is empty, mock mode is forced on regardless of this value.
PAYMENTS_MOCK_MODE=true

# Razorpay Dashboard -> Settings -> API Keys.
# Business KYC (PAN, GSTIN, bank account) takes several days — start early.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings -> Webhooks -> point at https://YOURDOMAIN/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Public key id — safe in the browser, this one is meant to be exposed.
NEXT_PUBLIC_RAZORPAY_KEY_ID=


# =============================================================================
# 7. WHATSAPP  [OPTIONAL — everything works without it]
# =============================================================================
# While false: every trigger still runs, still enforces frequency caps, and
# still writes a "would_send" row. The admin dashboard is fully populated.
# Nothing is sent, nothing is charged.
FEATURE_WHATSAPP_LIVE=false

# Prefer meta_cloud_api (direct): no monthly fee, ~Rs 0.12/message.
# A BSP (interakt/gupshup) adds Rs 2,000-2,500/mo for an inbox you don't need.
WA_PROVIDER=mock
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Anti-spam caps. Enforced server-side before every send.
WA_FREQUENCY_CAP_LOW_STOCK_PER_SKU_PER_WEEK=1
WA_FREQUENCY_CAP_PER_USER_PER_WEEK=3


# =============================================================================
# 8. SHIPPING  [NOW-AUTO: manual works fine]
# =============================================================================
# manual     -> quotes from your own zone/rate tables; you type the AWB in admin.
# shiprocket -> automatic AWB + live tracking.
SHIPPING_PROVIDER=manual
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Cash on delivery. Amount in PAISE: 500000 = Rs 5,000.
FEATURE_COD_ENABLED=true
COD_MAX_ORDER_PAISE=500000


# =============================================================================
# 9. FEATURE FLAGS  [NOW-AUTO]
# =============================================================================
FEATURE_WISHLIST=true
FEATURE_RESTOCK_ALERTS=true
FEATURE_POPUPS=true
FEATURE_REELS=true
FEATURE_MANUAL_RECS=true

# Coming-soon pages. false = show the coming-soon blurb (still a real route,
# still in the nav, never a 404). Flip to true when you have real content.
FEATURE_EVENTS_PAGE_LIVE=false
FEATURE_INFLUENCER_PAGE_LIVE=false
FEATURE_MYOC_PAGE_LIVE=false


# =============================================================================
# 10. TAX / INVOICING  [NOW-AUTO — confirm with your CA before taking money]
# =============================================================================
# Placeholder: 18% GST, HSN 7117 (imitation jewellery).
# Both are editable PER PRODUCT in the admin; these are only the defaults.
DEFAULT_GST_RATE_PERCENT=18
DEFAULT_HSN_CODE=7117
# Indian financial-year invoice series, resets each 1 April.
INVOICE_SERIES_PREFIX=SORBE
INVOICE_SERIES_FY=25-26


# =============================================================================
# 11. OBSERVABILITY  [OPTIONAL — free tier]
# =============================================================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
