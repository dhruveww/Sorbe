{
  "name": "@sorbe/medusa",
  "version": "0.1.0",
  "private": true,
  "description": "SORBE commerce backend — Medusa v2 (self-hosted, free)",
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "start": "medusa start",
    "db:migrate": "medusa db:migrate",
    "db:setup": "medusa db:migrate && medusa exec ./src/scripts/seed.ts",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:catalog": "medusa exec ./src/scripts/seed-catalog.ts",
    "user": "medusa user",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no medusa tests yet\" && exit 0"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.20.1",
    "@medusajs/cli": "2.20.1",
    "@medusajs/framework": "2.20.1",
    "@medusajs/medusa": "2.20.1",
    "@mikro-orm/core": "6.6.14",
    "@mikro-orm/knex": "6.6.14",
    "@mikro-orm/migrations": "6.6.14",
    "@mikro-orm/postgresql": "6.6.14",
    "@sorbe/config": "workspace:*",
    "@sorbe/types": "workspace:*",
    "@sorbe/validation": "workspace:*",
    "awilix": "^8.0.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.20.1",
    "@swc/core": "^1.7.28",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
